<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear Nueva Publicación"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etTituloPub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título del producto"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDescripcionPub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción detallada"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etPrecioPub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etUbicacionPub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ciudad o Comuna (Ej. Iquique)"
            android:inputType="textCapWords"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Condición del producto:"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerCondicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicar"
            android:backgroundTint="#673AB7"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>