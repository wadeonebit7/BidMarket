<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F8FA" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#202936" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="30dp" android:paddingBottom="30dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PUBLICACIONES  /  BIDMARKET+" android:textSize="11sp" android:textColor="#91C8CE" android:textStyle="bold" android:layout_marginBottom="9dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crear publicación" android:textSize="27sp" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Agrega los detalles de tu producto para que otros usuarios puedan encontrarlo." android:textSize="14sp" android:textColor="#C8D4DE" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="20dp" android:paddingBottom="32dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bidmarket_ui_card" android:padding="18dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/bidmarket_ui_number" android:text="01" android:textStyle="bold" android:textColor="#FFFFFF" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Información del producto" android:textColor="#202936" android:textStyle="bold" android:textSize="17sp" android:layout_marginStart="10dp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Describe tu artículo de forma clara y precisa." android:textSize="13sp" android:textColor="#687889" android:layout_marginBottom="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Título del producto" android:textSize="14sp" android:textColor="#354052" android:textStyle="bold" />
                <EditText android:id="@+id/etTituloPub" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bidmarket_ui_input" android:hint="Ej. Bicicleta urbana aro 26" android:textColor="#202936" android:textColorHint="#85909C" android:textSize="15sp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:inputType="textCapSentences" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:minHeight="52dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descripción" android:textSize="14sp" android:textColor="#354052" android:textStyle="bold" />
                <EditText android:id="@+id/etDescripcionPub" android:layout_width="match_parent" android:layout_height="108dp" android:background="@drawable/bidmarket_ui_input" android:hint="Estado, características y detalles importantes" android:textColor="#202936" android:textColorHint="#85909C" android:textSize="15sp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:inputType="textMultiLine|textCapSentences" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:minHeight="52dp" android:minLines="3" android:gravity="top|start" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Precio (CLP)" android:textSize="14sp" android:textColor="#354052" android:textStyle="bold" />
                <EditText android:id="@+id/etPrecioPub" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bidmarket_ui_input" android:hint="Ej. 45000" android:textColor="#202936" android:textColorHint="#85909C" android:textSize="15sp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:inputType="numberDecimal" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:minHeight="52dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bidmarket_ui_card" android:padding="18dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/bidmarket_ui_number" android:text="02" android:textStyle="bold" android:textColor="#FFFFFF" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clasificación y venta" android:textColor="#202936" android:textStyle="bold" android:textSize="17sp" android:layout_marginStart="10dp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selecciona la categoría, modalidad y condición." android:textSize="13sp" android:textColor="#687889" android:layout_marginBottom="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Categoría" android:textSize="14sp" android:textColor="#354052" android:textStyle="bold" />
                <Spinner android:id="@+id/spinnerCategoria" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bidmarket_ui_input" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:spinnerMode="dropdown" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modalidad de venta" android:textSize="14sp" android:textColor="#354052" android:textStyle="bold" />
                <Spinner android:id="@+id/spinnerModalidad" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bidmarket_ui_input" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:spinnerMode="dropdown" />
                <Button android:id="@+id/btnFechaFin" android:layout_width="match_parent" android:layout_height="54dp" android:text="Elegir fecha de término de la subasta" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="#202936" android:backgroundTint="#E8EEF3" android:layout_marginTop="0dp" android:visibility="gone" android:layout_marginBottom="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Condición" android:textSize="14sp" android:textColor="#354052" android:textStyle="bold" />
                <Spinner android:id="@+id/spinnerCondicion" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bidmarket_ui_input" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:spinnerMode="dropdown" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bidmarket_ui_card" android:padding="18dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/bidmarket_ui_number" android:text="03" android:textStyle="bold" android:textColor="#FFFFFF" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ubicación del producto" android:textColor="#202936" android:textStyle="bold" android:textSize="17sp" android:layout_marginStart="10dp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Indica la zona donde se encuentra el artículo." android:textSize="13sp" android:textColor="#687889" android:layout_marginBottom="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ciudad o comuna" android:textSize="14sp" android:textColor="#354052" android:textStyle="bold" />
                <EditText android:id="@+id/etUbicacionPub" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bidmarket_ui_input" android:hint="Ej. Iquique" android:textColor="#202936" android:textColorHint="#85909C" android:textSize="15sp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:inputType="textCapWords" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:minHeight="52dp" />
                <Button android:id="@+id/btnUsarGps" android:layout_width="match_parent" android:layout_height="54dp" android:text="Usar mi ubicación GPS" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="#202936" android:backgroundTint="#E8EEF3" android:layout_marginTop="0dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="La ubicación GPS es opcional. Puedes escribir tu ciudad." android:textSize="12sp" android:textColor="#778494" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bidmarket_ui_card" android:padding="18dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/bidmarket_ui_number" android:text="04" android:textStyle="bold" android:textColor="#FFFFFF" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fotografía del producto" android:textColor="#202936" android:textStyle="bold" android:textSize="17sp" android:layout_marginStart="10dp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Una imagen clara ayuda a presentar mejor la publicación." android:textSize="13sp" android:textColor="#687889" android:layout_marginBottom="14dp" />
                <Button android:id="@+id/btnSeleccionarImagen" android:layout_width="match_parent" android:layout_height="54dp" android:text="Seleccionar fotografía" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="#202936" android:backgroundTint="#E8EEF3" android:layout_marginTop="0dp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="12dp" android:background="@drawable/bidmarket_ui_preview" android:padding="8dp">
                    <ImageView android:id="@+id/ivVistaPrevia" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:adjustViewBounds="true" android:contentDescription="Vista previa de la fotografía seleccionada" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="La imagen se ajusta al espacio sin recortar el producto." android:textSize="12sp" android:textColor="#778494" />
            </LinearLayout>
            <Button android:id="@+id/btnPublicar" android:layout_width="match_parent" android:layout_height="54dp" android:text="Publicar producto" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#202936" android:layout_marginTop="0dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revisa los datos antes de guardar la publicación." android:textSize="12sp" android:textColor="#778494" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
