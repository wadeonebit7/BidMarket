<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

 <!-- Encabezado -->
 <LinearLayout
     android:id="@+id/encabezadoMapa"
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:paddingStart="24dp"
     android:paddingEnd="24dp"
     android:paddingTop="20dp"
     android:paddingBottom="20dp"
     android:background="#FFFFFF"
     app:layout_constraintTop_toTopOf="parent"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="BidMarket+"
      android:textColor="#64748B"
      android:textSize="13sp"
      android:textStyle="bold" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="Ubicación del producto"
      android:textColor="#202936"
      android:textSize="24sp"
      android:textStyle="bold" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:text="Explora la ubicación en el mapa."
      android:textColor="#718096"
      android:textSize="13sp" />

 </LinearLayout>

 <!-- Mapa -->
 <androidx.fragment.app.FragmentContainerView
     android:id="@+id/mapFragment"
     android:name="com.google.android.gms.maps.SupportMapFragment"
     android:layout_width="0dp"
     android:layout_height="0dp"
     android:layout_marginTop="1dp"
     android:background="#E8EEF3"
     app:layout_constraintTop_toBottomOf="@id/encabezadoMapa"
     app:layout_constraintBottom_toTopOf="@id/panelSensor"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent" />

 <!-- Panel inferior del acelerómetro -->
 <LinearLayout
     android:id="@+id/panelSensor"
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:paddingStart="24dp"
     android:paddingEnd="24dp"
     android:paddingTop="14dp"
     android:paddingBottom="16dp"
     android:background="#FFFFFF"
     app:layout_constraintBottom_toBottomOf="parent"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Sensor de movimiento"
      android:textColor="#202936"
      android:textSize="14sp"
      android:textStyle="bold" />

  <TextView
      android:id="@+id/lecturaSensor"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:text="Esperando lectura del acelerómetro..."
      android:textColor="#718096"
      android:textSize="12sp"
      android:maxLines="3"
      android:ellipsize="end" />

 </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
