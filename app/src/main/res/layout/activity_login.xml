<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F7F8FA"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="BidMarket+" android:textColor="#171E29" android:textStyle="bold" android:textSize="20sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Bienvenido de nuevo" android:textColor="#171E29" android:textStyle="bold" android:textSize="29sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Inicia sesión para explorar, comprar y vender." android:textColor="#637185" android:textSize="14sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="35dp" android:text="Correo electrónico" android:textColor="#202936" android:textSize="14sp" android:textStyle="bold"/>
<EditText android:id="@+id/etCorreoLogin" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="@drawable/auth_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:hint="correo@ejemplo.com" android:singleLine="true" android:inputType="textEmailAddress" android:textColor="#202936" android:textColorHint="#8B96A4"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Contraseña" android:textColor="#202936" android:textSize="14sp" android:textStyle="bold"/>
<EditText android:id="@+id/etPasswordLogin" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="@drawable/auth_field" android:paddingStart="16dp" android:paddingEnd="16dp" android:hint="Tu contraseña" android:singleLine="true" android:inputType="textPassword" android:textColor="#202936" android:textColorHint="#8B96A4"/>
<Button android:id="@+id/btnIngresar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:backgroundTint="#171E29" android:text="Iniciar sesión" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="20dp" android:text="o" android:textColor="#637185" />
<Button android:id="@+id/btnGoogleLogin" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:backgroundTint="#FFFFFF" android:text="Continuar con Google" android:textAllCaps="false" android:textColor="#202124" android:textSize="15sp" />
<TextView android:id="@+id/tvIrRegistro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="27dp" android:padding="12dp" android:gravity="center" android:text="¿No tienes cuenta? Regístrate" android:textColor="#202936" android:clickable="true" android:focusable="true" />
</LinearLayout></ScrollView>