<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BidMarket+"
            android:textColor="#657386"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Iniciar sesión"
            android:textColor="#202936"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="36dp"
            android:text="Ingresa tus datos para continuar."
            android:textColor="#718096"
            android:textSize="15sp"/>

        <!-- Correo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textColor="#344256"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etCorreoLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="9dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/auth_field"
            android:hint="correo@ejemplo.com"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textColor="#202936"
            android:textColorHint="#94A3B8"
            android:textSize="15sp"/>

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Contraseña"
            android:textColor="#344256"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etPasswordLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="9dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/auth_field"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#202936"
            android:textColorHint="#94A3B8"
            android:textSize="15sp"/>

        <!-- Botón principal -->
        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#202936"
            android:text="Iniciar sesión"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="¿No tienes cuenta? Regístrate desde el inicio."
            android:textColor="#718096"
            android:textSize="13sp"/>

    </LinearLayout>

</ScrollView>
