<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

  <TextView
      android:id="@+id/tvTituloDashboard"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Últimas Publicaciones"
      android:textSize="22sp"
      android:textStyle="bold"
      android:padding="16dp"
      android:textColor="#333333"/>

  <!-- El RecyclerView se ubica debajo del título -->
  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvPublicaciones"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_below="@id/tvTituloDashboard"
      android:padding="8dp"
      android:clipToPadding="false"/>

  <!-- Botón Flotante para crear publicación -->
  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/fabAgregarPublicacion"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentBottom="true"
      android:layout_alignParentEnd="true"
      android:layout_margin="24dp"
      android:contentDescription="Nueva Publicación"
      android:src="@android:drawable/ic_input_add"
      app:backgroundTint="#673AB7"
      app:tint="#FFFFFF"/>

</RelativeLayout>