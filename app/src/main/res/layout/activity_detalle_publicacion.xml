<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detalleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171E29"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:fitsSystemWindows="false"
    android:scrollbars="none">

 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:paddingBottom="32dp">

  <!-- Fotografía del producto -->
  <ImageView
      android:id="@+id/detImagen"
      android:layout_width="match_parent"
      android:layout_height="300dp"
      android:background="#242E3D"
      android:scaleType="fitCenter"
      android:contentDescription="Imagen del producto" />

  <!-- Información principal -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp">

   <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:text="PUBLICACIÓN"
       android:textSize="11sp"
       android:textStyle="bold"
       android:letterSpacing="0.15"
       android:textColor="#94A3B8" />

   <TextView
       android:id="@+id/detTitulo"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:text="Nombre del producto"
       android:textColor="#FFFFFF"
       android:textSize="26sp"
       android:textStyle="bold" />

   <TextView
       android:id="@+id/detPrecio"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="12dp"
       android:text="$ 0"
       android:textColor="#FFFFFF"
       android:textSize="30sp"
       android:textStyle="bold" />

   <View
       android:layout_width="match_parent"
       android:layout_height="1dp"
       android:layout_marginTop="24dp"
       android:background="#344052" />

   <!-- Descripción -->
   <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="24dp"
       android:text="Descripción"
       android:textColor="#FFFFFF"
       android:textSize="18sp"
       android:textStyle="bold" />

   <TextView
       android:id="@+id/detDescripcion"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:textColor="#B6C2D2"
       android:textSize="15sp"
       android:lineSpacingExtra="5dp" />

   <!-- Ubicación -->
   <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="28dp"
       android:text="Ubicación"
       android:textColor="#FFFFFF"
       android:textSize="18sp"
       android:textStyle="bold" />

   <TextView
       android:id="@+id/detUbicacion"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="8dp"
       android:textColor="#B6C2D2"
       android:textSize="15sp" />

   <Button
       android:id="@+id/btnMapa"
       android:layout_width="match_parent"
       android:layout_height="52dp"
       android:layout_marginTop="16dp"
       android:text="Ver ubicación en el mapa"
       android:textAllCaps="false"
       android:textColor="#FFFFFF"
       android:backgroundTint="#344357" />

   <!-- Información de la subasta -->
   <TextView
       android:id="@+id/detSubasta"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="24dp"
       android:padding="16dp"
       android:background="#263447"
       android:textColor="#E2E8F0"
       android:textSize="15sp"
       android:lineSpacingExtra="4dp"
       android:visibility="gone" />

   <EditText
       android:id="@+id/etMontoPuja"
       android:layout_width="match_parent"
       android:layout_height="56dp"
       android:layout_marginTop="16dp"
       android:paddingHorizontal="16dp"
       android:hint="Ingresa tu oferta en CLP"
       android:inputType="number"
       android:singleLine="true"
       android:textColor="#FFFFFF"
       android:textColorHint="#9AA9BA"
       android:backgroundTint="#94A3B8"
       android:visibility="gone" />

   <!-- Acciones de compra -->
   <Button
       android:id="@+id/btnComprar"
       android:layout_width="match_parent"
       android:layout_height="56dp"
       android:layout_marginTop="20dp"
       android:text="Comprar producto"
       android:textAllCaps="false"
       android:textStyle="bold"
       android:textColor="#171E29"
       android:backgroundTint="#FFFFFF"
       android:visibility="gone" />

   <Button
       android:id="@+id/btnPujar"
       android:layout_width="match_parent"
       android:layout_height="56dp"
       android:layout_marginTop="12dp"
       android:text="Registrar oferta"
       android:textAllCaps="false"
       android:textStyle="bold"
       android:textColor="#171E29"
       android:backgroundTint="#FFFFFF"
       android:visibility="gone" />

   <Button
       android:id="@+id/btnChatVendedor"
       android:layout_width="match_parent"
       android:layout_height="54dp"
       android:layout_marginTop="12dp"
       android:text="Contactar vendedor"
       android:textAllCaps="false"
       android:textColor="#FFFFFF"
       android:backgroundTint="#344357"
       android:visibility="gone" />

   <!-- Acciones del propietario -->
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="16dp"
       android:orientation="vertical">

    <Button
        android:id="@+id/btnEditar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Editar publicación"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#344357"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnPausar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Pausar publicación"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#344357"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnVendido"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Marcar como vendido"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#344357"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnEliminar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Eliminar publicación"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#823C48"
        android:visibility="gone" />

   </LinearLayout>

   <!-- Compartir -->
   <Button
       android:id="@+id/btnCompartir"
       android:layout_width="match_parent"
       android:layout_height="52dp"
       android:layout_marginTop="12dp"
       android:text="Compartir publicación"
       android:textAllCaps="false"
       android:textColor="#FFFFFF"
       android:backgroundTint="#344357" />

  </LinearLayout>

 </LinearLayout>

</ScrollView>
