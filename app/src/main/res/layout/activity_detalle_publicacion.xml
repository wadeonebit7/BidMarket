<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:padding="18dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
  <ImageView android:id="@+id/detImagen" android:layout_width="match_parent" android:layout_height="220dp" android:scaleType="centerCrop" android:contentDescription="Imagen del producto" />
  <TextView android:id="@+id/detTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" />
  <TextView android:id="@+id/detPrecio" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" />
  <TextView android:id="@+id/detDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" />
  <TextView android:id="@+id/detUbicacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" />
  <TextView android:id="@+id/detSubasta" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" />
  <EditText android:id="@+id/etMontoPuja" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Oferta en pesos chilenos" android:inputType="number" android:visibility="gone" />
  <Button android:id="@+id/btnComprar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Comprar (registro local)" android:visibility="gone" />
  <Button android:id="@+id/btnPujar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registrar oferta" android:visibility="gone" />
  <Button android:id="@+id/btnEditar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Editar" android:visibility="gone" />
  <Button android:id="@+id/btnPausar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pausar" android:visibility="gone" />
  <Button android:id="@+id/btnVendido" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Marcar vendido" android:visibility="gone" />
  <Button android:id="@+id/btnEliminar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Eliminar" android:visibility="gone" />
  <Button android:id="@+id/btnChatVendedor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contactar vendedor" android:visibility="gone" />
  <Button android:id="@+id/btnMapa" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ver mapa y mi ubicación" />
  <Button android:id="@+id/btnCompartir" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compartir publicación" />
 </LinearLayout>
</ScrollView>
